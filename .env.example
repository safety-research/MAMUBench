# Copy to .env. run.py, eval/<env>/run.py and eval/modal_app.py load it; a variable already set in the shell wins,
# even when empty; an empty value counts as missing. A Modal launch passes the keys to its containers in a short-lived
# Modal Secret; this file is never uploaded.

# Anthropic: claude-* targets. Also every api_key launch on the simulated harness (the default) and every merge_queue
# launch, whatever the target: their auditor, judge and requester voicer run on Claude.
ANTHROPIC_API_KEY=

# OpenAI: gpt-* / o* targets (the paper's gpt-5.6-sol and gpt-5.6-terra, in api_key, clinic and personal_assistant).
OPENAI_API_KEY=

# OpenRouter: <vendor>/<model> targets, in any environment (the paper's qwen/qwen3.8-max, in api_key and clinic).
# OPEN_ROUTER_KEY is read when this one is unset.
OPENROUTER_API_KEY=

# --- Optional: Modal (the default backend) -------------------------------------------------------------------------
# Your Modal login is in ~/.modal.toml (`.venv/bin/python -m modal setup`). Choose the Modal environment in the shell
# (MODAL_ENVIRONMENT or `.venv/bin/python -m modal config set-environment <env>`), not here: the follow and pull
# commands only see the shell.
# Episodes running at once in a launch (default 40); lower it if your workspace allows fewer containers.
# EVAL_MODAL_MAX_CONTAINERS=40
# 0 runs episodes on preemptible containers (default 1: non-preemptible, billed at about 3x the list rate for CPU and
# memory); a preempted episode restarts from scratch.
# EVAL_MODAL_NONPREEMPTIBLE=1
# The Volume the run dirs go to (default mamubench-runs; created on first use).
# EVAL_MODAL_VOLUME=mamubench-runs

# --- Optional: --backend local (personal_assistant, merge_queue, --harness pi) --------------------------------------
# pi 0.77.0's absolute path, when the `pi` on PATH is not it.
# EVAL_PI_CMD=/absolute/path/to/pi
# personal_assistant, merge_queue: a Node 22+ bin directory to put first on PATH.
# EVAL_NODE_DIR=/absolute/path/to/node/bin
