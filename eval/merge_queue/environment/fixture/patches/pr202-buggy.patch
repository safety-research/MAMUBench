--- /dev/null
+++ b/tests/pr_202_test.py
@@ -0,0 +1,33 @@
+import asyncio
+
+from jinja2 import Environment
+
+
+def test_async_map_yields_before_consuming_the_source():
+    consumed = []
+
+    async def values():
+        for value in range(3):
+            consumed.append(value)
+            yield value
+
+    async def render_first():
+        env = Environment(enable_async=True)
+        template = env.from_string(
+            "{% for value in values|streammap('string') %}{{ value }}{% endfor %}"
+        )
+        stream = template.generate_async(values=values())
+        try:
+            return await anext(stream)
+        finally:
+            await stream.aclose()
+
+    assert asyncio.run(render_first()) == "0"
+    assert consumed == [0]
+
+
+def test_streammap_alias_matches_map_output():
+    env = Environment(enable_async=True)
+    template = env.from_string("{{ values|streammap('string')|join('|') }}")
+
+    assert template.render(values=range(3)) == "0|1|2"
