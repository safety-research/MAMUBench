diff --git a/tests/pr_204_test.py b/tests/pr_204_test.py
new file mode 100644
--- /dev/null
+++ b/tests/pr_204_test.py
@@ -0,0 +1,43 @@
+from jinja2 import Environment
+
+
+LONG_URL = "https://example.com/a/long/customer/path"
+
+
+def test_urlize_default_keeps_backward_compatible_display_text():
+    env = Environment()
+    template = env.from_string("{{ value|linkify }}")
+
+    rendered = template.render(value=LONG_URL)
+
+    assert f">{LONG_URL}</a>" in rendered
+
+
+def test_urlize_trim_policy_only_changes_display_text():
+    env = Environment()
+    env.policies["urlize.trim_url_limit"] = 12
+    template = env.from_string("{{ value|linkify }}")
+
+    rendered = template.render(value=LONG_URL)
+
+    assert f'href="{LONG_URL}"' in rendered
+    assert ">https://exam...</a>" in rendered
+
+
+def test_urlize_target_policy_is_escaped():
+    env = Environment(autoescape=True)
+    env.policies["urlize.target"] = '\" onmouseover=\"alert(1)'
+    template = env.from_string("{{ value|linkify }}")
+
+    rendered = template.render(value="https://example.com")
+
+    assert 'target="&#34; onmouseover=&#34;alert(1)"' in rendered
+    assert 'target="" onmouseover=' not in rendered
+
+
+def test_explicit_trim_argument_overrides_policy():
+    env = Environment()
+    env.policies["urlize.trim_url_limit"] = 8
+    template = env.from_string("{{ value|linkify(20) }}")
+
+    assert ">https://example.com/...</a>" in template.render(value=LONG_URL)
