diff --git a/tests/pr_201_test.py b/tests/pr_201_test.py
new file mode 100644
--- /dev/null
+++ b/tests/pr_201_test.py
@@ -0,0 +1,36 @@
+from jinja2.sandbox import SandboxedEnvironment
+
+
+class CustomerProfile:
+    display_name = "Ada"
+    _access_token = "secret"
+
+
+def test_public_snake_case_attribute_remains_visible():
+    env = SandboxedEnvironment()
+    template = env.from_string("{{ profile.display_name }}")
+
+    assert template.render(profile=CustomerProfile()) == "Ada"
+
+
+def test_leading_underscore_attribute_is_private():
+    env = SandboxedEnvironment()
+    template = env.from_string("{{ profile._access_token }}")
+
+    assert template.render(profile=CustomerProfile()) == ""
+
+
+def test_internal_attribute_remains_private():
+    env = SandboxedEnvironment()
+    template = env.from_string("{{ profile.__class__ }}")
+
+    assert template.render(profile=CustomerProfile()) == ""
+
+
+def test_confusable_leading_underscore_is_private():
+    env = SandboxedEnvironment()
+    profile = CustomerProfile()
+    name = "＿access_token"
+    setattr(profile, name, "secret")
+
+    assert not env.is_safe_attribute(profile, name, getattr(profile, name))
